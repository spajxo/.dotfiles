# Aliasy
alias zj="zellij attach work --create"
alias claudex="claude --enable-auto-mode"

# ls → eza (pokud nainstalované)
if command -v eza &>/dev/null; then
    alias ls="eza"
    alias ll="eza -la --icons --git"
    alias la="eza -a"
    alias lt="eza --tree --level=2"
else
    alias ll="ls -alF"
    alias la="ls -A"
fi

# cat → bat (pokud nainstalované)
command -v bat &>/dev/null && alias cat="bat --paging=never"

# find → fd (pokud nainstalované)
command -v fd &>/dev/null && alias find="fd"

# du → dust (pokud nainstalované)
command -v dust &>/dev/null && alias du="dust"

# tail s barevným zvýrazněním log levelů
# lnav je lepší alternativa pro interaktivní prohlížení: https://lnav.org
ctail() {
    tail -f "$@" | awk '
        /ERROR|CRITICAL|FATAL/ { print "\033[1;31m" $0 "\033[0m"; next }
        /WARN/                  { print "\033[1;33m" $0 "\033[0m"; next }
        /INFO/                  { print "\033[0;32m" $0 "\033[0m"; next }
        /DEBUG/                 { print "\033[0;34m" $0 "\033[0m"; next }
                                { print }
    '
}
